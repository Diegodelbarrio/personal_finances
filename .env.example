SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False

# Comma-separated values
ALLOWED_HOSTS=your-domain.com,www.your-domain.com
CSRF_TRUSTED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# Prefer DATABASE_URL in production
DATABASE_URL=postgres://user:password@host:5432/dbname

# Optional DB_* fallback (used only if DATABASE_URL is empty)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=finorbit
DB_USER=finorbit_user
DB_PASSWORD=replace-me
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=600
DB_SSL_REQUIRE=True

SITE_ID=1
SITE_URL=https://your-domain.com

# Email:
# In DEBUG=True local env you can skip SMTP and rely on console backend.
# In production set EMAIL_BACKEND to SMTP and fill host credentials.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_SUBJECT_PREFIX=[FinOrbit]
ACCOUNT_EMAIL_SUBJECT_PREFIX=[FinOrbit]
EMAIL_FAIL_SILENTLY=False
DEFAULT_FROM_EMAIL=noreply@your-domain.com
SERVER_EMAIL=noreply@your-domain.com
EMAIL_HOST=smtp.your-provider.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-smtp-user
EMAIL_HOST_PASSWORD=your-smtp-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
EMAIL_TRANSACTIONAL_FROM_EMAIL=transactions@your-domain.com
EMAIL_TRANSACTIONAL_REPLY_TO=support@your-domain.com
NEW_USER_NOTIFICATION_ENABLED=True
NEW_USER_NOTIFICATION_RECIPIENTS=admin@your-domain.com
NEW_USER_WELCOME_EMAIL_ENABLED=True

# Optional dedicated channel for newsletters/campaigns
EMAIL_MARKETING_ENABLED=True
EMAIL_MARKETING_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_MARKETING_FROM_EMAIL=news@your-domain.com
EMAIL_MARKETING_REPLY_TO=newsletter@your-domain.com
EMAIL_MARKETING_BATCH_SIZE=500
EMAIL_MARKETING_HOST=smtp-marketing.your-provider.com
EMAIL_MARKETING_PORT=587
EMAIL_MARKETING_HOST_USER=your-marketing-user
EMAIL_MARKETING_HOST_PASSWORD=your-marketing-password
EMAIL_MARKETING_USE_TLS=True
EMAIL_MARKETING_USE_SSL=False
EMAIL_MARKETING_TIMEOUT=10

SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
USE_X_FORWARDED_HOST=True

# Optional bank sync experiment.
# Keep this disabled in the committed example; enable it only in your real .env.
BANK_SYNC_ENABLED=False
BANK_SYNC_PROVIDER=mock
BANK_SYNC_COUNTRY_CODE=ES
BANK_SYNC_HTTP_TIMEOUT=20

# GoCardless Bank Account Data credentials.
# Store real values only in your local/production environment, never in chat or git.
GOCARDLESS_BASE_URL=https://bankaccountdata.gocardless.com/api/v2
GOCARDLESS_SECRET_ID=
GOCARDLESS_SECRET_KEY=
GOCARDLESS_REFRESH_TOKEN=

YAPILY_APPLICATION_ID=
YAPILY_APPLICATION_SECRET=
YAPILY_BASE_URL=https://api.yapily.com
